{
  "version": 8,
  "configurePresets": [
    {
      "name": "mingw-debug",
      "displayName": "MinGW (Debug)",
      "description": "MinGW build for everyday debugging (no profiling)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_RC_COMPILER": "windres",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW (Release)",
      "description": "MinGW build for releases (no debugging symbols)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/toolchains/ninja",
        "CMAKE_C_COMPILER": "${sourceDir}/toolchains/mingw64/bin/gcc",
        "CMAKE_CXX_COMPILER": "${sourceDir}/toolchains/mingw64/bin/g++",
        "CMAKE_RC_COMPILER": "${sourceDir}/toolchains/mingw64/bin/windres",
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },

    {
      "name": "msvc-profile",
      "displayName": "MSVC Profile",
      "description": "MSVC build with symbols and optimisations for CPU profiling",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "ProgramDatabase",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug"
    },
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release"
    },
    {
      "name": "msvc-profile",
      "configurePreset": "msvc-profile"
    }
  ]
}
